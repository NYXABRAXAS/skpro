@inject Microsoft.Extensions.Options.IOptions<SelfKioskOptions> KioskOptions
@{
    var cfg = KioskOptions.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@(ViewData["Title"] ?? "Welcome to Suryoday Car Loan") · @cfg.BankName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/consent.css" asp-append-version="true" />
</head>
<body class="sy-consent-body">
    @if (cfg.MockMode)
    {
        <div class="sy-mock-strip" role="note">
            DEMO / MOCK MODE — all verifications use sample data. No real APIs are called.
        </div>
    }

    @RenderBody()

    @* No jQuery unobtrusive validation here: the [Range(bool,"true","true")] consent
       rules are enforced server-side, and consent.js handles the Proceed gating.
       (Unobtrusive turns that rule into a numeric range check that fails on "true".) *@
    <script src="~/js/consent.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
