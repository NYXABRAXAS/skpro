<div class="modal-backdrop-x" id="sessionModal" role="alertdialog" aria-labelledby="sessionTitle" aria-modal="true" aria-hidden="true">
    <div class="modal-x">
        <h3 id="sessionTitle">Your session is about to expire</h3>
        <p>For your security this application will reset in <strong id="sessionCountdown">15</strong> seconds.</p>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="sessionStay">Continue</button>
            <button type="button" class="btn btn-ghost" id="sessionStartOver">Start Over</button>
        </div>
    </div>
</div>
