@model StepViewModel
@{
    ViewData["Title"] = "Aadhaar Verification";
    ViewData["StepModel"] = Model;
    ViewData["EnableTimeout"] = true;
    var otpSent = Model.App.AadhaarOtpSent && !Model.App.AadhaarVerified;
    var remainingResends = Model.MaxOtpResendAttempts - Model.App.AadhaarOtpResendCount;
}

<div class="card-surface">
    <h1 class="page-title">Aadhaar Verification</h1>

    @if (TempData["OtpError"] is string te)
    {
        <div class="alert alert-danger">@te</div>
    }

    @if (!otpSent)
    {
        <p class="page-subtitle">
            Enter your Aadhaar number. An OTP will be sent by UIDAI to the mobile number registered with your Aadhaar.
        </p>

        @if (Model.MockMode)
        {
            <div class="info-panel">Demo mode: enter any 12 digit number (e.g. <strong>1234 1234 1234</strong>).</div>
        }

        <form method="post" action="/car-loan/aadhaar/send">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="field">
                <label for="AadhaarNumber">Enter Aadhaar Number</label>
                <input class="input masked" id="AadhaarNumber" name="AadhaarNumber" inputmode="numeric"
                       data-numeric="12" autocomplete="off" placeholder="XXXX XXXX XXXX" />
                <span class="hint">Your Aadhaar number is masked and never stored or displayed in full.</span>
            </div>
            <div class="btn-row">
                <button type="submit" class="btn btn-cta">Send OTP</button>
            </div>
        </form>

        <a class="back-link" href="/car-loan/consent">&larr; Back</a>
    }
    else
    {
        <p class="page-subtitle">
            Enter the @Model.OtpExpirySeconds-second OTP sent to the mobile number registered with your Aadhaar
            (<strong>@Model.App.AadhaarMasked</strong>).
        </p>

        @if (Model.MockMode)
        {
            <div class="info-panel">Demo Aadhaar OTP: <strong>@Model.MockOtp</strong></div>
        }

        <form method="post" action="/car-loan/aadhaar/verify">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" id="Otp" name="Otp" value="" />
            <div class="field">
                <label>Enter Aadhaar OTP</label>
                <div class="otp-inputs" data-otp>
                    @for (var i = 0; i < 6; i++)
                    {
                        <input data-otp-box inputmode="numeric" maxlength="1" aria-label="Aadhaar OTP digit @(i + 1)" />
                    }
                </div>
            </div>
            <div class="btn-row">
                <button type="submit" class="btn btn-cta">Verify Aadhaar</button>
            </div>
        </form>

        <p class="resend-line"><span data-resend-label>Resend OTP in 30 seconds</span></p>
        <form method="post" action="/car-loan/aadhaar/resend" style="text-align:center;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-ghost" data-resend-btn data-resend-seconds="30"
                    @(remainingResends <= 0 ? "disabled" : "")>
                Resend OTP@(remainingResends < Model.MaxOtpResendAttempts ? $" ({Math.Max(remainingResends, 0)} left)" : "")
            </button>
        </form>

        <form method="post" action="/car-loan/aadhaar/change" style="text-align:center;margin-top:4px;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-ghost">Change Aadhaar number</button>
        </form>
    }
</div>
