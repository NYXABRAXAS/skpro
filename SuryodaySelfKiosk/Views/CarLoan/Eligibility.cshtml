@model StepViewModel
@{
    ViewData["Title"] = "Calculating Your Eligibility";
    ViewData["StepModel"] = Model;
    ViewData["EnableTimeout"] = true;
    var error = TempData["ProcessingError"] as string;
}

<div class="card-surface processing">
    @if (error is not null)
    {
        <div class="result-icon no" aria-hidden="true">!</div>
        <h1 class="page-title">Something went wrong</h1>
        <p class="page-subtitle">@error</p>
        <form method="post" action="/car-loan/eligibility">
            @Html.AntiForgeryToken()
            <div class="btn-row">
                <button type="submit" class="btn btn-cta">Try Again</button>
            </div>
        </form>
    }
    else
    {
        <h1 class="page-title">Calculating Your Car Loan Eligibility</h1>
        <div class="spinner" aria-hidden="true"></div>
        <p class="page-subtitle">Evaluating your application against our lending policy.</p>
        <ul class="check-list">
            <li class="ok">Customer verification</li>
            <li class="ok">PAN verification</li>
            <li class="ok">Credit profile check</li>
            <li class="pending">Evaluating loan eligibility</li>
        </ul>
        <form method="post" action="/car-loan/eligibility" data-auto-submit="3000">
            @Html.AntiForgeryToken()
        </form>
        <noscript>
            <form method="post" action="/car-loan/eligibility">
                @Html.AntiForgeryToken()
                <div class="btn-row"><button type="submit" class="btn btn-cta">Continue</button></div>
            </form>
        </noscript>
    }
</div>
