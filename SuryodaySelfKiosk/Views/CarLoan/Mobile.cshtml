@model StepViewModel
@{
    ViewData["Title"] = "Verify Your Mobile Number";
    ViewData["StepModel"] = Model;
    ViewData["EnableTimeout"] = true;
    var otpSent = Model.App.OtpSent && !Model.App.MobileVerified;
    var remainingResends = Model.MaxOtpResendAttempts - Model.App.OtpResendCount;
    var mob = Model.App.MobileNumber ?? "";
    var mobMasked = mob.Length >= 4 ? "XXXXXX" + mob.Substring(mob.Length - 4) : "XXXXXXXXXX";
}

<div class="card-surface">
    <h1 class="page-title">Verify Your Mobile Number</h1>

    @if (Model.App.AadhaarVerified)
    {
        <div class="alert alert-success">
            <span aria-hidden="true">✓</span>
            <span>Aadhaar verified. Registered mobile number: <strong>@Model.App.RegisteredMobileMasked</strong></span>
        </div>
    }

    @if (TempData["OtpError"] is string te)
    {
        <div class="alert alert-danger">@te</div>
    }

    @if (!otpSent)
    {
        <p class="page-subtitle">We will send a one-time password (OTP) to this number.</p>
        <form method="post" action="/car-loan/mobile/send">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="field">
                <label for="MobileNumber">Enter 10 Digit Mobile Number</label>
                <input class="input" id="MobileNumber" name="MobileNumber" inputmode="numeric"
                       data-numeric="10" autocomplete="tel-national"
                       value="@Model.Mobile.MobileNumber" placeholder="9876543210" />
                <span class="hint">Enter the mobile number registered with your Aadhaar.</span>
            </div>
            <div class="btn-row">
                <button type="submit" class="btn btn-cta">Send OTP</button>
            </div>
        </form>
    }
    else
    {
        <p class="page-subtitle">
            Enter the @Model.OtpExpirySeconds-second OTP sent to <strong>@mobMasked</strong>.
        </p>

        @if (Model.MockMode)
        {
            <div class="info-panel">Demo OTP: <strong>@Model.MockOtp</strong></div>
        }

        <form method="post" action="/car-loan/mobile/verify">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" id="Otp" name="Otp" value="" />
            <div class="field">
                <label>Enter OTP</label>
                <div class="otp-inputs" data-otp>
                    @for (var i = 0; i < 6; i++)
                    {
                        <input data-otp-box inputmode="numeric" maxlength="1" aria-label="OTP digit @(i + 1)" />
                    }
                </div>
            </div>
            <div class="btn-row">
                <button type="submit" class="btn btn-cta">Verify &amp; Continue</button>
            </div>
        </form>

        <p class="resend-line">
            <span data-resend-label>Resend OTP in 30 seconds</span>
        </p>
        <form method="post" action="/car-loan/mobile/resend" style="text-align:center;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-ghost" data-resend-btn data-resend-seconds="30"
                    @(remainingResends <= 0 ? "disabled" : "")>
                Resend OTP@(remainingResends < Model.MaxOtpResendAttempts ? $" ({Math.Max(remainingResends, 0)} left)" : "")
            </button>
        </form>

        <form method="post" action="/car-loan/mobile/change" style="text-align:center;margin-top:4px;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-ghost">Change mobile number</button>
        </form>
    }

    <a class="back-link" href="/car-loan/aadhaar">&larr; Back</a>
</div>
